// IR line sensor tuning tool with HYSTERESIS (3 sensors: L, C, R).
// Upload alone (no motors). Serial Monitor at 9600 baud, "Newline" ending.

const int IR_PINS[3] = { A0, A1, A2 };
const char NAMES[3]  = { 'L', 'C', 'R' };

// Two thresholds per sensor: tape_low / tape_high define the dead zone.
// Paste calibrated values here after running 'c'.
int  thresh_low[3]  = { 256, 256, 256 };   // crossing this -> ON tape
int  thresh_high[3] = { 768, 768, 768 };   // crossing this -> OFF tape
bool TAPE_IS_HIGH  = false;                 // false: tape reads LOW (inverted module)

const unsigned long SWEEP_MS = 5000;

// Persistent state for hysteresis — survives between loop() calls.
bool tape_state[3] = { false, false, false };

int readAvg(int pin) {
  long sum = 0;
  for (int i = 0; i < 5; i++) sum += analogRead(pin);
  return sum / 5;
}

bool isTape(int i, int v) {
  if (TAPE_IS_HIGH) {
    if (v > thresh_high[i])      tape_state[i] = true;
    else if (v < thresh_low[i])  tape_state[i] = false;
    // else: in dead zone, keep previous state
  } else {
    if (v < thresh_low[i])      tape_state[i] = true;
    else if (v > thresh_high[i]) tape_state[i] = false;
    // else: in dead zone, keep previous state
  }
  return tape_state[i];
}

void calibrate() {
  int mn[3] = { 1023, 1023, 1023 };
  int mx[3] = { 0, 0, 0 };

  Serial.println();
  Serial.println("Sweeping for 5 s... slide sensors across tape AND floor now.");
  unsigned long t0 = millis();
  while (millis() - t0 < SWEEP_MS) {
    for (int i = 0; i < 3; i++) {
      int v = readAvg(IR_PINS[i]);
      if (v < mn[i]) mn[i] = v;
      if (v > mx[i]) mx[i] = v;
    }
    delay(5);
  }

  Serial.println("Results (min / max / contrast / low_thresh / high_thresh):");
  for (int i = 0; i < 3; i++) {
    int contrast = mx[i] - mn[i];
    // Place thresholds at 25% and 75% of the range — dead zone in the middle.
    int margin = contrast / 4;
    thresh_low[i]  = mn[i] + margin;
    thresh_high[i] = mx[i] - margin;

    Serial.print(NAMES[i]); Serial.print(":  ");
    Serial.print(mn[i]);    Serial.print(" / ");
    Serial.print(mx[i]);    Serial.print(" / ");
    Serial.print(contrast); Serial.print(" / ");
    Serial.print(thresh_low[i]);  Serial.print(" / ");
    Serial.print(thresh_high[i]);
    if (contrast < 150) Serial.print("   <-- LOW CONTRAST");
    Serial.println();
  }
  Serial.println();
  Serial.print("Paste:  int thresh_low[3]  = { ");
  Serial.print(thresh_low[0]);  Serial.print(", ");
  Serial.print(thresh_low[1]);  Serial.print(", ");
  Serial.print(thresh_low[2]);  Serial.println(" };");
  Serial.print("        int thresh_high[3] = { ");
  Serial.print(thresh_high[0]); Serial.print(", ");
  Serial.print(thresh_high[1]); Serial.print(", ");
  Serial.print(thresh_high[2]); Serial.println(" };");
  Serial.println();
}

void setup() {
  Serial.begin(9600);
  for (int i = 0; i < 3; i++) pinMode(IR_PINS[i], INPUT);
  Serial.println("IR tuning (hysteresis) ready.  'c' = calibrate,  'h' = flip polarity");
}

void loop() {
  while (Serial.available()) {
    char ch = Serial.read();
    if (ch == 'c') calibrate();
    if (ch == 'h') {
      TAPE_IS_HIGH = !TAPE_IS_HIGH;
      Serial.print("Tape is now: ");
      Serial.println(TAPE_IS_HIGH ? "HIGH (above high-thresh)" : "LOW (below low-thresh)");
    }
  }

  int v[3];
  bool t[3];
  for (int i = 0; i < 3; i++) {
    v[i] = readAvg(IR_PINS[i]);
    t[i] = isTape(i, v[i]);
  }

  Serial.print("raw  L:"); Serial.print(v[0]);
  Serial.print("  C:");    Serial.print(v[1]);
  Serial.print("  R:");    Serial.print(v[2]);
  Serial.print("   | tape  ");
  Serial.print(t[0]); Serial.print(' ');
  Serial.print(t[1]); Serial.print(' ');
  Serial.println(t[2]);

  delay(100);
}
